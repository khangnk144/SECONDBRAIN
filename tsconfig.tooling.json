{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "scripts/**/*.ts",
    "eslint-rules/**/*.ts",
    "playwright.config.ts",
    "web/e2e/**/*.ts",
    "vitest.config.ts"
  ]
}
